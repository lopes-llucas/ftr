    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Monta a mensagem final de forma determinística.\n// Também é o fallback do Gemini: se o nó do Gemini falhar ou não tiver\n// credencial, esta é a mensagem enviada ao usuário.\nconst { cidade, temperatura } = $input.item.json;\n\nreturn {\n  json: {\n    ...$input.item.json,\n    message: `🌤️ A temperatura em ${cidade} é de ${temperatura}°C.`,\n    ok: true,\n  },\n};"
      },
      "id": "5260c125-9fb9-4dc0-b1c6-5b8578b06b50",
      "name": "Mensagem fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        -96
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Mensagem original: {{ $json.message }}\nCidade: {{ $json.cidade }}\nTemperatura: {{ $json.temperatura }}°C\nCondição do tempo: {{ $json.descricao }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Você reescreve mensagens curtas de clima para um chatbot do Telegram. Responda sempre em português do Brasil. Comece com o emoji 🌤️, mantenha exatamente o nome da cidade e a temperatura recebidos (não invente valores nem arredonde de novo), use no máximo duas frases curtas e um tom amigável. Responda apenas no formato JSON {\"message\": \"...\", \"ok\": true}."
            }
          ]
        },
        "batching": {}
      },
