        "assignments": {
          "assignments": [
            {
              "id": "4fdefdf4-2764-4d78-915f-7d7f1e2de991",
              "name": "queue",
              "value": "={{ (() => {\n  const ufs = ['ac', 'al', 'ap', 'am', 'ba', 'ce', 'df', 'es', 'go', 'ma', 'mt', 'ms', 'mg', 'pa', 'pb', 'pr', 'pe', 'pi', 'rj', 'rn', 'rs', 'ro', 'rr', 'sc', 'sp', 'se', 'to'];\n  const texto = ($json.message.text || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/\\s+-\\s+|[\\/;()]/g, ',');\n  let partes = texto.split(',').map(parte => parte.trim().replace(/\\s+/g, ' ')).filter(parte => parte !== '');\n  const ufSemVirgula = partes.length === 1 && partes[0].match(/^(.+?)[\\s-]+([a-z]{2})$/);\n  if (ufSemVirgula && ufs.includes(ufSemVirgula[2])) partes = [ufSemVirgula[1], ufSemVirgula[2]];\n  if (partes.length > 0 && partes[partes.length - 1] !== 'br') partes.push('br');\n  return partes.join(',');\n})() }}",
              "type": "string"
            },
            {
              "id": "f14272ef-9587-460f-8069-0c2a0bdf203e",
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
