# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore: ele NUNCA vai para o repositório.

# ngrok — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Domínio estático gratuito do ngrok, sem https:// (ex.: meu-dominio.ngrok-free.app)
# https://dashboard.ngrok.com/domains
NGROK_DOMAIN=

# OpenWeather — https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Telegram — token entregue pelo @BotFather ao criar o bot
TELEGRAM_BOT_TOKEN=

# Opcional: Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
